+static struct vfs_fsentry d2xqfs_fsentry = {
+	.vfe_vfsops = &d2xqfs_vfsops,
+	.vfe_vopcnt = 1,
+	.vfe_opvdescs = d2xqfs_vnodeop_descs,
+	.vfe_fstypenum = 0,
+	.vfe_fsname = D2XQFS_FSNAME,
+	.vfe_flags = VFS_TBLCANMOUNTROOT | VFS_TBLVNOP_PAGEINV2 | VFS_TBLTHREADSAFE |
+	    VFS_TBL64BITREADY,
