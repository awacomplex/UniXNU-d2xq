+static int
+d2xqfs_readdir(struct vnop_readdir_args *ap)
+{
+	struct vnode *vp = ap->a_vp;
+	struct uio *uio = ap->a_uio;
+	struct dirent dirent;
+	const struct d2xqfs_dirent_def *ents = NULL;
+	off_t pos = 0;
+	off_t startpos = uio_offset(uio);
+	int ino = (int)(uintptr_t)vnode_fsnode(vp);
+	int error = 0;
+	int idx;
+
+	if (ap->a_flags & (VNODE_READDIR_EXTENDED | VNODE_READDIR_REQSEEKOFF)) {
+		return EINVAL;
+	}
+	if (vnode_vtype(vp) != VDIR) {
+		return ENOTDIR;
+	}
+	switch (ino) {
+	case D2XQFS_ROOT:
+		ents = d2xqfs_root_entries;
+		break;
+	case D2XQFS_SBIN:
+		ents = d2xqfs_sbin_entries;
+		break;
+	case D2XQFS_DEV:
+		ents = d2xqfs_dev_entries;
+		break;
+	case D2XQFS_ETC:
+		ents = d2xqfs_etc_entries;
+		break;
+	default:
+		return ENOTDIR;
+	}
+
+	for (idx = 0; ; idx++) {
+		const char *name;
+		int child;
+		int type;
+		int reclen;
+
+		if (idx == 0) {
+			name = ".";
+			child = ino;
+			type = DT_DIR;
+		} else if (idx == 1) {
+			name = "..";
+			child = D2XQFS_ROOT;
+			type = DT_DIR;
+		} else {
+			const struct d2xqfs_dirent_def *e = &ents[idx - 2];
+
+			if (e->name == NULL) {
+				break;
+			}
+			name = e->name;
+			child = e->ino;
+			type = e->type;
+		}
+
+		bzero(&dirent, sizeof (dirent));
+		dirent.d_fileno = child;
+		dirent.d_namlen = (__uint8_t)strlen(name);
+		dirent.d_type = (__uint8_t)type;
+		reclen = (int)((sizeof (struct dirent) - (MAXNAMLEN + 1)) +
+		    (((dirent.d_namlen + 1 + 3) & ~3)));
+		dirent.d_reclen = (__uint16_t)reclen;
+
+		if (pos >= startpos) {
+			if ((int)uio_resid(uio) < reclen) {
+				break;
+			}
+			strlcpy(dirent.d_name, name, sizeof (dirent.d_name));
+			if ((error = uiomove((caddr_t)&dirent, reclen, uio)) != 0) {
+				break;
+			}
+		}
+		pos += reclen;
+	}
+
+	uio->uio_offset = pos;
+	/* a_eofflag / a_numdirent are left to the caller, like devfs_readdir:
+	 * filling in zero there makes getdirentries64 report no entries. */
+	return error;
+}
+
+static int
+d2xqfs_lookup(struct vnop_lookup_args *ap)
+{
+	vnode_t dvp = ap->a_dvp;
+	struct componentname *cnp = ap->a_cnp;
+	vnode_t *vpp = ap->a_vpp;
+	int ino = (int)(uintptr_t)vnode_fsnode(dvp);
+	int error = 0;
+	const char *name = cnp->cn_nameptr;
+	size_t len = cnp->cn_namelen;
+
+	*vpp = NULLVP;
+	if (len == 1 && name[0] == '.') {
+		error = vnode_get(dvp);
+		if (error == 0) {
+			*vpp = dvp;
+		}
+		return error;
+	}
+	if (len == 2 && name[0] == '.' && name[1] == '.') {
+		int parent = (ino == D2XQFS_ROOT) ? D2XQFS_ROOT :
+		    (ino == D2XQFS_SBIN || ino == D2XQFS_DEV || ino == D2XQFS_ETC) ? D2XQFS_ROOT : D2XQFS_ROOT;
+		return d2xqfs_create_vnode(vnode_mount(dvp), parent, vpp);
+	}
+
+	if (cnp->cn_nameiop == DELETE || cnp->cn_nameiop == RENAME) {
+		return EROFS;
+	}
+
+	switch (ino) {
+	case D2XQFS_ROOT:
+		if (len == 3 && bcmp(name, "etc", 3) == 0) {
+			return d2xqfs_create_vnode(vnode_mount(dvp), D2XQFS_ETC, vpp);
+		}
+		if (len == 4 && bcmp(name, "sbin", 4) == 0) {
+			return d2xqfs_create_vnode(vnode_mount(dvp), D2XQFS_SBIN, vpp);
+		}
+		if (len == 3 && bcmp(name, "dev", 3) == 0) {
+			return d2xqfs_create_vnode(vnode_mount(dvp), D2XQFS_DEV, vpp);
+		}
+		break;
+	case D2XQFS_SBIN:
+		if (len == 7 && bcmp(name, "launchd", 7) == 0) {
+			d2xq_phase(4, "lookup launchd");
+			d2xq_mark(4, 4);
+			return d2xqfs_create_vnode(vnode_mount(dvp), D2XQFS_INIT, vpp);
+		}
+		break;
+	case D2XQFS_ETC:
+		if (len == 4 && bcmp(name, "motd", 4) == 0) {
+			return d2xqfs_create_vnode(vnode_mount(dvp), D2XQFS_MOTD, vpp);
+		}
+		break;
+	case D2XQFS_DEV:
+		if (len == 7 && bcmp(name, "console", 7) == 0) {
+			return d2xqfs_create_vnode(vnode_mount(dvp), D2XQFS_CONSOLE, vpp);
+		}
+		if (len == 4 && bcmp(name, "null", 4) == 0) {
+			return d2xqfs_create_vnode(vnode_mount(dvp), D2XQFS_NULLDEV, vpp);
+		}
+		if (len == 4 && bcmp(name, "zero", 4) == 0) {
+			return d2xqfs_create_vnode(vnode_mount(dvp), D2XQFS_ZERODEV, vpp);
+		}
+		break;
+	default:
+		break;
+	}
+
+	if (cnp->cn_nameiop == CREATE) {
+		return EROFS;
+	}
+	return ENOENT;
+}
+
+static int
+d2xqfs_getattr_vn(struct vnop_getattr_args *ap)
+{
+	vnode_t vp = ap->a_vp;
+	struct vnode_attr *vap = ap->a_vap;
+	int ino = (int)(uintptr_t)vnode_fsnode(vp);
+
+	if (VATTR_IS_ACTIVE(vap, va_type)) {
+		vap->va_type = vnode_vtype(vp);
+		VATTR_SET_SUPPORTED(vap, va_type);
+	}
+	if (VATTR_IS_ACTIVE(vap, va_mode)) {
+		vap->va_mode = (ino == D2XQFS_CONSOLE || ino == D2XQFS_NULLDEV ||
+		    ino == D2XQFS_ZERODEV) ? (S_IFCHR | 0666) :
+		    (vnode_vtype(vp) == VDIR) ? (S_IFDIR | 0555) : (S_IFREG | 0644);
+		VATTR_SET_SUPPORTED(vap, va_mode);
+	}
+	if (VATTR_IS_ACTIVE(vap, va_nlink)) {
+		vap->va_nlink = 1;
+		VATTR_SET_SUPPORTED(vap, va_nlink);
+	}
+	if (VATTR_IS_ACTIVE(vap, va_uid)) {
+		vap->va_uid = 0;
+		VATTR_SET_SUPPORTED(vap, va_uid);
+	}
+	if (VATTR_IS_ACTIVE(vap, va_gid)) {
+		vap->va_gid = 0;
+		VATTR_SET_SUPPORTED(vap, va_gid);
+	}
+	if (VATTR_IS_ACTIVE(vap, va_fileid)) {
+		vap->va_fileid = ino;
+		VATTR_SET_SUPPORTED(vap, va_fileid);
+	}
+	if (VATTR_IS_ACTIVE(vap, va_fsid)) {
+		vap->va_fsid = 0;
+		VATTR_SET_SUPPORTED(vap, va_fsid);
+	}
+	if (VATTR_IS_ACTIVE(vap, va_data_size)) {
+		if (ino == D2XQFS_MOTD) {
+			d2xqfs_motd_init();
+		}
+		vap->va_data_size = (ino == D2XQFS_INIT) ? D2XQFS_IMAGE_SIZE :
+		    (ino == D2XQFS_MOTD) ? (off_t)d2xqfs_motd_len : 0;
+		VATTR_SET_SUPPORTED(vap, va_data_size);
+	}
+	if (VATTR_IS_ACTIVE(vap, va_rdev)) {
+		vap->va_rdev = (ino == D2XQFS_CONSOLE) ? makedev(0, 0) : 0;
+		VATTR_SET_SUPPORTED(vap, va_rdev);
+	}
+	if (VATTR_IS_ACTIVE(vap, va_gen)) {
+		vap->va_gen = 0;
+		VATTR_SET_SUPPORTED(vap, va_gen);
+	}
+	if (VATTR_IS_ACTIVE(vap, va_flags)) {
+		vap->va_flags = 0;
+		VATTR_SET_SUPPORTED(vap, va_flags);
+	}
+	if (VATTR_IS_ACTIVE(vap, va_access_time)) {
+		vap->va_access_time.tv_sec = 0;
+		vap->va_access_time.tv_nsec = 0;
+		VATTR_SET_SUPPORTED(vap, va_access_time);
+	}
+	if (VATTR_IS_ACTIVE(vap, va_modify_time)) {
+		vap->va_modify_time.tv_sec = 0;
+		vap->va_modify_time.tv_nsec = 0;
+		VATTR_SET_SUPPORTED(vap, va_modify_time);
+	}
+	if (VATTR_IS_ACTIVE(vap, va_change_time)) {
+		vap->va_change_time.tv_sec = 0;
+		vap->va_change_time.tv_nsec = 0;
+		VATTR_SET_SUPPORTED(vap, va_change_time);
+	}
+	return 0;
+}
+
+static int
+d2xqfs_read(struct vnop_read_args *ap)
+{
+	vnode_t vp = ap->a_vp;
+	struct uio *uio = ap->a_uio;
+	int ino = (int)(uintptr_t)vnode_fsnode(vp);
+	off_t off = uio_offset(uio);
+	int resid = (int)uio_resid(uio);
+
+	if (ino == D2XQFS_MOTD) {
+		size_t len;
+
+		d2xqfs_motd_init();
+		len = (size_t)d2xqfs_motd_len;
+		if (off >= (off_t)len) {
+			return 0;
+		}
+		if ((size_t)resid > len - (size_t)off) {
+			resid = (int)(len - (size_t)off);
+		}
+		return uiomove((caddr_t)(uintptr_t)&d2xqfs_motd_buf[off], resid, uio);
+	}
+	if (ino == D2XQFS_CONSOLE || ino == D2XQFS_NULLDEV) {
+		return 0;
+	}
+	if (ino == D2XQFS_ZERODEV) {
+		static const char zeroes[512];
+		int n = resid > (int)sizeof (zeroes) ? (int)sizeof (zeroes) : resid;
+
+		return uiomove((caddr_t)(uintptr_t)zeroes, n, uio);
+	}
+	if (ino != D2XQFS_INIT) {
+		return EISDIR;
+	}
+	if (off >= D2XQFS_IMAGE_SIZE) {
+		return 0;
+	}
+	if ((off_t)resid > D2XQFS_IMAGE_SIZE - off) {
+		resid = (int)(D2XQFS_IMAGE_SIZE - off);
+	}
+	return uiomove((caddr_t)(uintptr_t)&d2xqfs_image[off], resid, uio);
+}
+
+static int
+d2xqfs_write(struct vnop_write_args *ap)
+{
+	int wino = (int)(uintptr_t)vnode_fsnode(ap->a_vp);
+
+	if (wino == D2XQFS_MOTD) {
+		off_t off = uio_offset(ap->a_uio);
+
+		d2xqfs_motd_init();
+		if (off < 0) {
+			return EINVAL;
+		}
+		if ((unsigned)off >= D2XQFS_MOTD_MAX) {
+			return ENOSPC;
+		}
+		while (uio_resid(ap->a_uio) > 0) {
+			int resid = (int)uio_resid(ap->a_uio);
+			int space = (int)(D2XQFS_MOTD_MAX - (unsigned)off);
+			int n = resid > space ? space : resid;
+			int error;
+
+			if (n <= 0) {
+				return ENOSPC;
+			}
+			error = uiomove(&d2xqfs_motd_buf[off], n, ap->a_uio);
+			if (error != 0) {
+				return error;
+			}
+			off += n;
+			if ((unsigned)off > d2xqfs_motd_len) {
+				d2xqfs_motd_len = (unsigned)off;
+			}
+		}
+		return 0;
+	}
+
+	if (wino == D2XQFS_CONSOLE || wino == D2XQFS_NULLDEV ||
+	    wino == D2XQFS_ZERODEV) {
+		char scratch[64];
+		int error = 0;
+
+		while (uio_resid(ap->a_uio) > 0) {
+			int resid = (int)uio_resid(ap->a_uio);
+			int n = resid > (int)sizeof (scratch) ? (int)sizeof (scratch) : resid;
+			int i;
+
+			error = uiomove(scratch, n, ap->a_uio);
+			if (error != 0) {
+				break;
+			}
+			if (wino == D2XQFS_CONSOLE) {
+				for (i = 0; i < n; i++) {
+					d2xq_console_putc(scratch[i]);
+				}
+			}
+		}
+		return error;
+	}
+	return EROFS;
+}
