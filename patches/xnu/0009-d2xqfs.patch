+	0x22F000000210BE31, 0x23E0000021087A31, 0x26D0000000008421, 0x22E0000000074506,
+	0x04F1080000064842, 0x23100000000B6631, 0x2310000000022951, 0x23100000000556B5,
+	0x151000000008A884, 0x231000001D185B31, 0x11F00000000F8444, 0x0642109801821084,
