+
+static const struct d2xqfs_dirent_def d2xqfs_root_entries[] = {
+	{ "sbin", D2XQFS_SBIN, DT_DIR },
+	{ "dev", D2XQFS_DEV, DT_DIR },
+	{ "etc", D2XQFS_ETC, DT_DIR },
+	{ NULL, 0, 0 }
+};
+
+static const struct d2xqfs_dirent_def d2xqfs_sbin_entries[] = {
+	{ "launchd", D2XQFS_INIT, DT_REG },
+	{ NULL, 0, 0 }
+};
+
+static const struct d2xqfs_dirent_def d2xqfs_dev_entries[] = {
+	{ "console", D2XQFS_CONSOLE, DT_CHR },
+	{ "null", D2XQFS_NULLDEV, DT_CHR },
+	{ "zero", D2XQFS_ZERODEV, DT_CHR },
