+static const struct bdevsw d2xqfs_bdevsw = {
+	.d_open = d2xqfs_bd_open,
+	.d_close = d2xqfs_bd_close,
+	.d_strategy = d2xqfs_bd_strategy,
+	.d_ioctl = d2xqfs_bd_ioctl,
+	.d_dump = d2xqfs_bd_dump,
+	.d_psize = d2xqfs_bd_psize,
+	.d_type = D_DISK,
+};
+
+/* ------------------------------------------------------------------ */
+/* bootstrap                                                           */
+/* ------------------------------------------------------------------ */
+
+int
+d2xqfs_bootstrap(void)
+{
+	int error;
+
+	if (d2xqfs_registered) {
+		return 0;
+	}
+	d2xqfs_major = bdevsw_add(-1, &d2xqfs_bdevsw);
+	if (d2xqfs_major < 0) {
+		d2xq_mark(6, 6);
+		printf("d2xqfs: bdevsw_add failed: %d\n", d2xqfs_major);
+		return ENXIO;
+	}
+	error = vfs_fsadd(&d2xqfs_fsentry, &d2xqfs_vfstable);
+	if (error) {
+		d2xq_mark(7, 7);
+		printf("d2xqfs: vfs_fsadd failed: %d\n", error);
+		return error;
+	}
+	d2xqfs_registered = 1;
+	printf("d2xqfs: registered, block major %d\n", d2xqfs_major);
+	d2xq_phase(1, "bootstrap registered");
+	d2xq_mark(1, 1);
+	return 0;
+}
+
+dev_t
+d2xqfs_rootdev(void)
+{
+	if (d2xqfs_major < 0) {
+		return NODEV;
+	}
+	return makedev(d2xqfs_major, 0);
+}
+
+
+void
+d2xq_phase_bsd(int stage)
+{
+	d2xq_mark(0, 0);
+	d2xq_phase(stage, "bsd_init hook");
+}
diff --git a/bsd/vfs/vfs_subr.c b/bsd/vfs/vfs_subr.c
index 57aece6..58f7cd6 100644
--- a/bsd/vfs/vfs_subr.c
+++ b/bsd/vfs/vfs_subr.c
@@ -1206,9 +1206,51 @@ vfs_rootmountalloc(const char *fstypename, const char *devname, mount_t *mpp)
  */
 extern int (*mountroot)(void);
 
+/*
+ * d2xq: mount the synthetic root file system without going through a block
+ * device. The board has no bdevsw for its memory media, so bdevvp() fails and
+ * the usual root mount never offers any file system the chance to mount.
+ */
+static int
+d2xq_root_mount(void)
+{
+	extern void *d2xq_vfstable(void);
+	extern void d2xq_bar_stage(unsigned int);
+	struct vfstable *vfsp;
+	mount_t mp;
+	vfs_context_t ctx = vfs_context_kernel();
+	int error;
+
+	vfsp = (struct vfstable *)d2xq_vfstable();
+	if (vfsp == NULL) {
+		panic("D2XQ: no file system handle");
+	}
+	mp = vfs_rootmountalloc_internal(vfsp, "d2xq");
+	if (mp == NULL) {
+		panic("D2XQ: root mount allocation returned NULL, vfsp=%p", vfsp);
+	}
+	mp->mnt_flag |= MNT_ROOTFS;
+	error = VFS_MOUNT(mp, NULLVP, 0, ctx);
+	if (error) {
+		panic("D2XQ: VFS_MOUNT returned %d, mp=%p", error, mp);
+	}
+	d2xq_bar_stage(15);
+	vfs_unbusy(mp);
+	mount_list_add(mp);
+	(void)VFS_START(mp, 0, ctx);
+	return 0;
+}
