+static vm_offset_t d2xq_console_va;
+static unsigned d2xq_console_va_y;
+static vm_size_t d2xq_console_map_sz;
+static unsigned d2xq_console_map_off;
+static int d2xq_console_mapped;
+static int d2xq_console_ready;
+
+static const unsigned long long d2xq_font[96] = {
