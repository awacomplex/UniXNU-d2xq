+/* ------------------------------------------------------------------ */
+/* vnode creation                                                      */
+/* ------------------------------------------------------------------ */
+
+static int
+d2xqfs_create_vnode(mount_t mp, int ino, vnode_t *vpp)
+{
+	struct vnode_fsparam vfsp;
+	enum vtype type;
+	off_t size = 0;
+
+	switch (ino) {
+	case D2XQFS_ROOT:
+	case D2XQFS_SBIN:
+	case D2XQFS_DEV:
+	case D2XQFS_ETC:
+		type = VDIR;
+		break;
+	case D2XQFS_MOTD:
+		type = VREG;
+		d2xqfs_motd_init();
+		size = (off_t)d2xqfs_motd_len;
+		break;
+	case D2XQFS_CONSOLE:
+	case D2XQFS_NULLDEV:
+	case D2XQFS_ZERODEV:
+		type = VCHR;
+		break;
+	default:
+		type = VREG;
+		size = D2XQFS_IMAGE_SIZE;
+		break;
+	}
+
+	bzero(&vfsp, sizeof (vfsp));
+	vfsp.vnfs_mp = mp;
+	vfsp.vnfs_vtype = type;
+	vfsp.vnfs_str = D2XQFS_FSNAME;
+	vfsp.vnfs_fsnode = (void *)(uintptr_t)ino;
+	vfsp.vnfs_vops = d2xqfs_vnodeop_p;
+	vfsp.vnfs_markroot = (ino == D2XQFS_ROOT);
+	vfsp.vnfs_marksystem = 1;
+	vfsp.vnfs_rdev = (ino == D2XQFS_CONSOLE) ? makedev(0, 0) :
+	    (ino == D2XQFS_NULLDEV) ? makedev(0, 1) :
+	    (ino == D2XQFS_ZERODEV) ? makedev(0, 2) : 0;
+	vfsp.vnfs_filesize = size;
+	vfsp.vnfs_flags = VNFS_NOCACHE | VNFS_CANTCACHE;
+
+	return vnode_create(VNCREATE_FLAVOR, VCREATESIZE, &vfsp, vpp);
+}
