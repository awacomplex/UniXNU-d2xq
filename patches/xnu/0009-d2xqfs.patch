+/*
+ * d2xqfs: a read-only synthetic filesystem that serves one executable held in
+ * the kernel image.  It exists so that a Darwin port can reach userspace
+ * before a real on-disk filesystem driver is available.
+ *
+ * Layout:
+ *   /                 dir
+ *   /dev              dir
+ *   /dev/console      character device (writes are dropped)
+ *   /sbin             dir
+ *   /sbin/launchd     the embedded test executable
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/kernel.h>
+#include <sys/malloc.h>
+#include <sys/mount.h>
+#include <sys/vnode.h>
+#include <sys/vnode_if.h>
+#include <sys/namei.h>
+#include <sys/buf.h>
+#include <sys/uio.h>
+#include <sys/ubc.h>
+#include <sys/conf.h>
+#include <sys/dirent.h>
+#include <sys/errno.h>
+#include <sys/stat.h>
+#include <sys/vfs_context.h>
+#include <pexpert/pexpert.h>
+#include <libkern/libkern.h>
+
+#define D2XQFS_FSNAME   "d2xqfs"
+
+#define D2XQFS_ROOT     1
+#define D2XQFS_DEV      2
+#define D2XQFS_CONSOLE  3
+#define D2XQFS_SBIN     4
+#define D2XQFS_INIT     5
+#define D2XQFS_ETC      6
+#define D2XQFS_MOTD     7
+#define D2XQFS_NULLDEV  8
+#define D2XQFS_ZERODEV  9
+
+static const char d2xqfs_motd_text[] = "d2xqfs motd\n";
+
+#define D2XQFS_MOTD_MAX 256
+static char d2xqfs_motd_buf[D2XQFS_MOTD_MAX];
+static unsigned d2xqfs_motd_len;
+static int d2xqfs_motd_ready;
+
+static void
+d2xqfs_motd_init(void)
+{
+	size_t n = sizeof (d2xqfs_motd_text) - 1;
+
+	if (d2xqfs_motd_ready) {
+		return;
+	}
+	if (n > D2XQFS_MOTD_MAX) {
+		n = D2XQFS_MOTD_MAX;
+	}
+	bcopy(d2xqfs_motd_text, d2xqfs_motd_buf, n);
+	d2xqfs_motd_len = (unsigned)n;
+	d2xqfs_motd_ready = 1;
+}
