+}
+
+static int
+d2xqfs_vfs_getattr(struct mount *mp, struct vfs_attr *vfa, vfs_context_t ctx)
+{
+	if (VFSATTR_IS_ACTIVE(vfa, f_bsize)) {
+		vfa->f_bsize = 4096;
+		VFSATTR_SET_SUPPORTED(vfa, f_bsize);
+	}
+	if (VFSATTR_IS_ACTIVE(vfa, f_iosize)) {
+		vfa->f_iosize = 4096;
+		VFSATTR_SET_SUPPORTED(vfa, f_iosize);
+	}
+	if (VFSATTR_IS_ACTIVE(vfa, f_blocks)) {
+		vfa->f_blocks = 256;
+		VFSATTR_SET_SUPPORTED(vfa, f_blocks);
+	}
+	if (VFSATTR_IS_ACTIVE(vfa, f_bfree)) {
+		vfa->f_bfree = 0;
+		VFSATTR_SET_SUPPORTED(vfa, f_bfree);
+	}
+	if (VFSATTR_IS_ACTIVE(vfa, f_bavail)) {
+		vfa->f_bavail = 0;
+		VFSATTR_SET_SUPPORTED(vfa, f_bavail);
+	}
+	if (VFSATTR_IS_ACTIVE(vfa, f_files)) {
+		vfa->f_files = 5;
+		VFSATTR_SET_SUPPORTED(vfa, f_files);
+	}
+	if (VFSATTR_IS_ACTIVE(vfa, f_ffree)) {
+		vfa->f_ffree = 0;
+		VFSATTR_SET_SUPPORTED(vfa, f_ffree);
+	}
+	return 0;
+}
