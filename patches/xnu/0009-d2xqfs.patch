+/*
+ * d2xqfs: a read-only synthetic filesystem that serves one executable held in
+ * the kernel image.  It exists so that a Darwin port can reach userspace
+ * before a real on-disk filesystem driver is available.
+ *
+ * Layout:
+ *   /                 dir
+ *   /dev              dir
+ *   /dev/console      character device (writes are dropped)
+ *   /sbin             dir
+ *   /sbin/launchd     the embedded test executable
+ */
