+static unsigned d2xq_console_x;
+static unsigned d2xq_console_y;
+
+static void
+d2xq_console_putc(char c)
+{
+	const unsigned cell = 5u * D2XQ_CONSOLE_SCALE;
+	const unsigned line = 12u * D2XQ_CONSOLE_SCALE;
+	unsigned long long glyph;
+	unsigned long long want;
+	unsigned long long base;
+	unsigned long long off;
+	unsigned top;
+	unsigned bottom;
+	unsigned data;
+	unsigned row;
+	unsigned col;
+	unsigned dy;
+	unsigned dx;
+	unsigned px;
+	volatile unsigned *fb;
+
+	if (!d2xq_console_ready) {
+		d2xq_console_x = D2XQ_CONSOLE_X0;
+		d2xq_console_y = D2XQ_CONSOLE_Y0;
+		d2xq_console_ready = 1;
+	}
+	if (c == '\n') {
+		d2xq_console_x = D2XQ_CONSOLE_X0;
+		d2xq_console_y += line;
+		return;
+	}
+	if (c == '\t') {
+		d2xq_console_x += 4u * cell;
+		return;
+	}
+	if ((unsigned char)c < 32 || (unsigned char)c > 126) {
+		return;
+	}
+	if (d2xq_console_x + cell > D2XQ_CONSOLE_WIDTH) {
+		d2xq_console_x = D2XQ_CONSOLE_X0;
+		d2xq_console_y += line;
+	}
+	if (d2xq_console_y + line > D2XQ_CONSOLE_HEIGHT) {
+		return;
+	}
+	/* One text line at a time, page aligned: ml_io_unmap() rejects a size
+	 * that is not a whole number of pages. */
+	if (!d2xq_console_mapped || d2xq_console_va_y != d2xq_console_y) {
+		if (d2xq_console_mapped) {
+			ml_io_unmap(d2xq_console_va, d2xq_console_map_sz);
+			d2xq_console_mapped = 0;
+		}
+		want = (unsigned long long)d2xq_console_y * D2XQ_CONSOLE_STRIDE;
+		d2xq_console_map_off = (unsigned)(want & 0xFFFu);
+		base = 0x9C400000ULL + (want & ~0xFFFULL);
+		d2xq_console_map_sz = (vm_size_t)(((unsigned long long)d2xq_console_map_off +
+		    (unsigned long long)line * D2XQ_CONSOLE_STRIDE + 0xFFFu) & ~0xFFFULL);
+		d2xq_console_va = ml_io_map((vm_offset_t)base, d2xq_console_map_sz);
+		if (d2xq_console_va == 0) {
+			return;
+		}
+		d2xq_console_va_y = d2xq_console_y;
+		d2xq_console_mapped = 1;
+		fb = (volatile unsigned *)d2xq_console_va;
+		for (row = 0; row < line; row++) {
+			for (px = 0; px < D2XQ_CONSOLE_WIDTH; px++) {
+				fb[((unsigned long long)(d2xq_console_map_off + row * D2XQ_CONSOLE_STRIDE) +
+				    (unsigned long long)px * 4) / 4] = 0;
+			}
+		}
+	}
+	fb = (volatile unsigned *)d2xq_console_va;
+	glyph = d2xq_font[(unsigned char)c - 32];
+	top = (unsigned)(glyph >> 32);
+	bottom = (unsigned)glyph;
+	for (row = 0; row < 12; row++) {
+		data = (row < 6) ? (top >> (row * 5)) : (bottom >> ((row - 6) * 5));
+		for (col = 0; col < 5; col++) {
+			for (dy = 0; dy < D2XQ_CONSOLE_SCALE; dy++) {
+				for (dx = 0; dx < D2XQ_CONSOLE_SCALE; dx++) {
+					off = (unsigned long long)(d2xq_console_map_off +
+					    (row * D2XQ_CONSOLE_SCALE + dy) * D2XQ_CONSOLE_STRIDE) +
+					    (unsigned long long)(d2xq_console_x + col * D2XQ_CONSOLE_SCALE + dx) * 4;
+					fb[off / 4] = ((data >> col) & 1u) ? 0x00FFFFFFu : 0u;
+				}
+			}
+		}
+	}
+	d2xq_console_x += cell;
+}
