+static int
+d2xqfs_pagein(struct vnop_pagein_args *ap)
+{
+	int ino = (int)(uintptr_t)vnode_fsnode(ap->a_vp);
+	d2xq_phase(5, "pagein");
+	d2xq_mark(5, 5);
+	upl_t upl = ap->a_pl;
+	upl_page_info_t *plinfo = NULL;
+	vm_offset_t dst = 0;
+	int error;
+	off_t off = ap->a_f_offset + ap->a_pl_offset;
+	size_t size = ap->a_size;
+	boolean_t created = FALSE;
+
+	if (upl == NULL) {
+		/* The caller wants the range placed at a_pl_offset inside the
+		 * UPL, so the UPL must cover a_pl_offset + a_size. */
+		size_t total = (size_t)ap->a_pl_offset + (size_t)ap->a_size;
+
+		error = ubc_create_upl(ap->a_vp, ap->a_f_offset, (int)total,
+		    &upl, &plinfo, UPL_UBC_PAGEIN | UPL_RET_ONLY_ABSENT);
+		if (error) {
+			return error;
+		}
+		created = TRUE;
+	}
+	error = ubc_upl_map(upl, &dst);
+	if (error) {
+		if (created) {
+			ubc_upl_abort_range(upl, 0,
+			    (upl_size_t)(ap->a_pl_offset + ap->a_size),
+			    UPL_ABORT_FREE_ON_EMPTY | UPL_ABORT_ERROR);
+		}
+		return error;
+	}
+	if (created) {
+		size_t total = (size_t)ap->a_pl_offset + (size_t)ap->a_size;
+
+		bzero((caddr_t)dst, total);
+	}
+	bzero((caddr_t)(dst + ap->a_pl_offset), size);
+	if (ino == D2XQFS_INIT && off < D2XQFS_IMAGE_SIZE) {
+		size_t n = size;
+		if ((off_t)n > D2XQFS_IMAGE_SIZE - off) {
+			n = (size_t)(D2XQFS_IMAGE_SIZE - off);
+		}
+		bcopy(&d2xqfs_image[off], (caddr_t)(dst + ap->a_pl_offset), n);
+	} else if (ino == D2XQFS_MOTD &&
+	    off < (off_t)d2xqfs_motd_len) {
+		size_t len = (size_t)d2xqfs_motd_len;
+		size_t n = size;
+		if ((size_t)n > len - (size_t)off) {
+			n = len - (size_t)off;
+		}
+		bcopy(&d2xqfs_motd_buf[off], (caddr_t)(dst + ap->a_pl_offset), n);
+	}
+	ubc_upl_unmap(upl);
+	if (created) {
+		ubc_upl_commit_range(upl, ap->a_pl_offset, (upl_size_t)ap->a_size,
+		    UPL_COMMIT_FREE_ON_EMPTY | UPL_COMMIT_CLEAR_DIRTY |
+		    UPL_COMMIT_WRITTEN_BY_KERNEL | UPL_COMMIT_INACTIVATE);
+	}
+	return 0;
+}
