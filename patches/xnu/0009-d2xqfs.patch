+/* console output: draw userland writes on the frame buffer            */
+/* ------------------------------------------------------------------ */
+
+#define D2XQ_CONSOLE_SCALE  6u
+#define D2XQ_CONSOLE_STRIDE 5760u
+#define D2XQ_CONSOLE_WIDTH  1440u
+#define D2XQ_CONSOLE_HEIGHT 3040u
+#define D2XQ_CONSOLE_X0     96u
+#define D2XQ_CONSOLE_Y0     2400u
