+static int
+d2xqfs_mount(struct mount *mp, vnode_t devvp, user_addr_t data, vfs_context_t ctx)
+{
+	d2xq_phase(2, "d2xqfs_mount entered");
+	d2xq_mark(2, 2);
+	vfs_getnewfsid(mp);
+	vfs_setfsprivate(mp, &d2xqfs_mount_data);
+	mp->mnt_flag |= MNT_LOCAL | MNT_RDONLY | MNT_DONTBROWSE;
+	(void)devvp;
+	(void)data;
+	(void)ctx;
+	return 0;
+}
+
