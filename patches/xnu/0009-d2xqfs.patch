+ * not visible on this board and the panic screen needs video state that does
+ * not exist yet this early, so the bands are the reliable bring-up channel.
+ * The panel is 1440x3040 at 32 bpp with a 5760-byte row stride. */
+extern vm_offset_t ml_io_map(vm_offset_t phys, vm_size_t size);
+
+static void
+d2xq_bar(unsigned stage, unsigned color)
+{
+	static const unsigned colors[16] = {
+		0x00FF0000u, 0x00FFFFFFu, 0x00FFFF00u, 0x0000FFFFu,
+		0x00FF8000u, 0x008000FFu, 0x00808000u, 0x00808080u,
+		0x00800000u, 0x00008000u, 0x00000080u, 0x00808080u,
+		0x00FF00FFu, 0x0000FF80u, 0x0080FF00u, 0x00404040u
+	};
+	const vm_size_t stride = 5760;
+	const unsigned height = 60;
+	unsigned y = 300 + stage * 72;
+	vm_offset_t va;
+
+	/* The frame buffer is reported by physical address; ml_io_map() gives us
+	 * the kernel mapping for the band we paint. */
+	va = ml_io_map(0x9C400000UL + (vm_offset_t)y * stride, height * stride);
+	if (va == 0) {
+		/* Fall back to the kernel's video mapping, but only when it is a
+		 * kernel virtual address; early in boot it still holds the raw
+		 * physical base and writing through it would fault. */
+		extern PE_state_t PE_state;
+		vm_offset_t cand = (vm_offset_t)PE_state.video.v_baseAddr;
+
+		if (cand >= 0xFFFFFF0000000000ULL) {
+			va = cand + (vm_offset_t)y * stride;
+		}
+	}
+	if (va == 0) {
+		return;
+	}
+	for (vm_size_t i = 0; i < height * stride / 4; i++) {
+		((volatile unsigned *)va)[i] = colors[color & 15];
+	}
+}
+
+static void
+d2xq_mark(unsigned stage, unsigned color)
+{
+	int requested = 0;
+
+	if (PE_parse_boot_argn("d2xq_bars", &requested, sizeof (requested)) == 0) {
+		return;
+	}
+	d2xq_bar(stage, color);
+}
