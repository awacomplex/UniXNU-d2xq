+
+static int
+d2xqfs_pagein(struct vnop_pagein_args *ap)
+{
+	int ino = (int)(uintptr_t)vnode_fsnode(ap->a_vp);
+	d2xq_phase(5, "pagein");
+	d2xq_mark(5, 5);
+	upl_t upl = ap->a_pl;
+	upl_page_info_t *plinfo = NULL;
+	vm_offset_t dst = 0;
+	int error;
+	off_t off = ap->a_f_offset + ap->a_pl_offset;
+	size_t size = ap->a_size;
+	boolean_t created = FALSE;
+
+	if (upl == NULL) {
+		error = ubc_create_upl(ap->a_vp, ap->a_f_offset, (int)ap->a_size,
+		    &upl, &plinfo, UPL_UBC_PAGEIN | UPL_RET_ONLY_ABSENT);
+		if (error) {
+			return error;
+		}
+		created = TRUE;
+	}
+	error = ubc_upl_map(upl, &dst);
+	if (error) {
+		if (created) {
+			ubc_upl_abort_range(upl, ap->a_pl_offset, (upl_size_t)ap->a_size,
+			    UPL_ABORT_FREE_ON_EMPTY | UPL_ABORT_ERROR);
+		}
+		return error;
+	}
+	bzero((caddr_t)(dst + ap->a_pl_offset), size);
+	if (ino == D2XQFS_INIT && off < D2XQFS_IMAGE_SIZE) {
+		size_t n = size;
+		if ((off_t)n > D2XQFS_IMAGE_SIZE - off) {
+			n = (size_t)(D2XQFS_IMAGE_SIZE - off);
+		}
+		bcopy(&d2xqfs_image[off], (caddr_t)(dst + ap->a_pl_offset), n);
+	}
+	ubc_upl_unmap(upl);
+	if (created) {
+		ubc_upl_commit_range(upl, ap->a_pl_offset, (upl_size_t)ap->a_size,
+		    UPL_COMMIT_FREE_ON_EMPTY | UPL_COMMIT_CLEAR_DIRTY |
+		    UPL_COMMIT_WRITTEN_BY_KERNEL | UPL_COMMIT_INACTIVATE);
+	}
+	return 0;
+}
+
+static int
+d2xqfs_pageout(struct vnop_pageout_args *ap)
+{
+	return EROFS;
+}
+
+static int
+d2xqfs_blockmap(struct vnop_blockmap_args *ap)
+{
+	return ENOTSUP;
+}
+
+/* ------------------------------------------------------------------ */
+/* vnode creation                                                      */
+/* ------------------------------------------------------------------ */
+
+static int
+d2xqfs_create_vnode(mount_t mp, int ino, vnode_t *vpp)
+{
+	struct vnode_fsparam vfsp;
+	enum vtype type;
+	off_t size = 0;
+
+	switch (ino) {
+	case D2XQFS_ROOT:
+	case D2XQFS_SBIN:
+	case D2XQFS_DEV:
+		type = VDIR;
+		break;
+	case D2XQFS_CONSOLE:
+		type = VCHR;
+		break;
+	default:
+		type = VREG;
+		size = D2XQFS_IMAGE_SIZE;
+		break;
+	}
+
+	bzero(&vfsp, sizeof (vfsp));
+	vfsp.vnfs_mp = mp;
+	vfsp.vnfs_vtype = type;
+	vfsp.vnfs_str = D2XQFS_FSNAME;
+	vfsp.vnfs_fsnode = (void *)(uintptr_t)ino;
+	vfsp.vnfs_vops = d2xqfs_vnodeop_p;
+	vfsp.vnfs_markroot = (ino == D2XQFS_ROOT);
+	vfsp.vnfs_marksystem = 1;
+	vfsp.vnfs_rdev = (ino == D2XQFS_CONSOLE) ? makedev(0, 0) : 0;
+	vfsp.vnfs_filesize = size;
+	vfsp.vnfs_flags = VNFS_NOCACHE | VNFS_CANTCACHE;
+
+	return vnode_create(VNCREATE_FLAVOR, VCREATESIZE, &vfsp, vpp);
+}
