+	.vfs_mount = d2xqfs_mount,
+	.vfs_start = d2xqfs_start,
+	.vfs_unmount = d2xqfs_unmount,
+	.vfs_root = d2xqfs_root,
+	.vfs_getattr = d2xqfs_vfs_getattr,
+	.vfs_sync = d2xqfs_sync,
+	.vfs_init = d2xqfs_vfs_init,
+};
