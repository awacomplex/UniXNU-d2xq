+static int d2xqfs_create_vnode(mount_t, int, vnode_t *);
+
+static int
+d2xqfs_lookup(struct vnop_lookup_args *ap)
+{
+	vnode_t dvp = ap->a_dvp;
+	struct componentname *cnp = ap->a_cnp;
+	vnode_t *vpp = ap->a_vpp;
+	int ino = (int)(uintptr_t)vnode_fsnode(dvp);
+	int error = 0;
+	const char *name = cnp->cn_nameptr;
+	size_t len = cnp->cn_namelen;
+
+	*vpp = NULLVP;
+	if (len == 1 && name[0] == '.') {
+		error = vnode_get(dvp);
+		if (error == 0) {
+			*vpp = dvp;
+		}
+		return error;
+	}
+	if (len == 2 && name[0] == '.' && name[1] == '.') {
+		int parent = (ino == D2XQFS_ROOT) ? D2XQFS_ROOT :
+		    (ino == D2XQFS_SBIN || ino == D2XQFS_DEV) ? D2XQFS_ROOT : D2XQFS_ROOT;
+		return d2xqfs_create_vnode(vnode_mount(dvp), parent, vpp);
+	}
+
+	if (cnp->cn_nameiop == DELETE || cnp->cn_nameiop == RENAME) {
+		return EROFS;
+	}
+
+	switch (ino) {
+	case D2XQFS_ROOT:
+		if (len == 4 && bcmp(name, "sbin", 4) == 0) {
+			return d2xqfs_create_vnode(vnode_mount(dvp), D2XQFS_SBIN, vpp);
+		}
+		if (len == 3 && bcmp(name, "dev", 3) == 0) {
+			return d2xqfs_create_vnode(vnode_mount(dvp), D2XQFS_DEV, vpp);
+		}
+		break;
+	case D2XQFS_SBIN:
+		if (len == 7 && bcmp(name, "launchd", 7) == 0) {
+			d2xq_phase(4, "lookup launchd");
+			d2xq_mark(4, 4);
+			return d2xqfs_create_vnode(vnode_mount(dvp), D2XQFS_INIT, vpp);
+		}
+		break;
+	case D2XQFS_DEV:
+		if (len == 7 && bcmp(name, "console", 7) == 0) {
+			return d2xqfs_create_vnode(vnode_mount(dvp), D2XQFS_CONSOLE, vpp);
+		}
+		break;
+	default:
+		break;
+	}
+
+	if (cnp->cn_nameiop == CREATE) {
+		return EROFS;
+	}
+	return ENOENT;
+}
+
+static int
+d2xqfs_getattr_vn(struct vnop_getattr_args *ap)
+{
+	vnode_t vp = ap->a_vp;
+	struct vnode_attr *vap = ap->a_vap;
+	int ino = (int)(uintptr_t)vnode_fsnode(vp);
+
+	if (VATTR_IS_ACTIVE(vap, va_type)) {
+		vap->va_type = vnode_vtype(vp);
+		VATTR_SET_SUPPORTED(vap, va_type);
+	}
+	if (VATTR_IS_ACTIVE(vap, va_mode)) {
+		vap->va_mode = (ino == D2XQFS_CONSOLE) ? (S_IFCHR | 0666) :
+		    (vnode_vtype(vp) == VDIR) ? (S_IFDIR | 0555) : (S_IFREG | 0555);
+		VATTR_SET_SUPPORTED(vap, va_mode);
+	}
+	if (VATTR_IS_ACTIVE(vap, va_nlink)) {
+		vap->va_nlink = 1;
+		VATTR_SET_SUPPORTED(vap, va_nlink);
+	}
+	if (VATTR_IS_ACTIVE(vap, va_uid)) {
+		vap->va_uid = 0;
+		VATTR_SET_SUPPORTED(vap, va_uid);
+	}
+	if (VATTR_IS_ACTIVE(vap, va_gid)) {
+		vap->va_gid = 0;
+		VATTR_SET_SUPPORTED(vap, va_gid);
+	}
+	if (VATTR_IS_ACTIVE(vap, va_fileid)) {
+		vap->va_fileid = ino;
+		VATTR_SET_SUPPORTED(vap, va_fileid);
+	}
+	if (VATTR_IS_ACTIVE(vap, va_fsid)) {
+		vap->va_fsid = 0;
+		VATTR_SET_SUPPORTED(vap, va_fsid);
+	}
+	if (VATTR_IS_ACTIVE(vap, va_data_size)) {
+		vap->va_data_size = (ino == D2XQFS_INIT) ? D2XQFS_IMAGE_SIZE : 0;
+		VATTR_SET_SUPPORTED(vap, va_data_size);
+	}
+	if (VATTR_IS_ACTIVE(vap, va_rdev)) {
+		vap->va_rdev = (ino == D2XQFS_CONSOLE) ? makedev(0, 0) : 0;
+		VATTR_SET_SUPPORTED(vap, va_rdev);
+	}
+	if (VATTR_IS_ACTIVE(vap, va_gen)) {
+		vap->va_gen = 0;
+		VATTR_SET_SUPPORTED(vap, va_gen);
+	}
+	if (VATTR_IS_ACTIVE(vap, va_flags)) {
+		vap->va_flags = 0;
+		VATTR_SET_SUPPORTED(vap, va_flags);
+	}
+	if (VATTR_IS_ACTIVE(vap, va_access_time)) {
+		vap->va_access_time.tv_sec = 0;
+		vap->va_access_time.tv_nsec = 0;
+		VATTR_SET_SUPPORTED(vap, va_access_time);
+	}
+	if (VATTR_IS_ACTIVE(vap, va_modify_time)) {
+		vap->va_modify_time.tv_sec = 0;
+		vap->va_modify_time.tv_nsec = 0;
+		VATTR_SET_SUPPORTED(vap, va_modify_time);
+	}
+	if (VATTR_IS_ACTIVE(vap, va_change_time)) {
+		vap->va_change_time.tv_sec = 0;
+		vap->va_change_time.tv_nsec = 0;
+		VATTR_SET_SUPPORTED(vap, va_change_time);
+	}
+	return 0;
+}
+
+static int
+d2xqfs_read(struct vnop_read_args *ap)
+{
+	vnode_t vp = ap->a_vp;
+	struct uio *uio = ap->a_uio;
+	int ino = (int)(uintptr_t)vnode_fsnode(vp);
+	off_t off = uio_offset(uio);
+	int resid = (int)uio_resid(uio);
+
+	if (ino != D2XQFS_INIT) {
+		return EISDIR;
+	}
+	if (off >= D2XQFS_IMAGE_SIZE) {
+		return 0;
+	}
+	if ((off_t)resid > D2XQFS_IMAGE_SIZE - off) {
+		resid = (int)(D2XQFS_IMAGE_SIZE - off);
+	}
+	return uiomove((caddr_t)(uintptr_t)&d2xqfs_image[off], resid, uio);
+}
+
+static int
+d2xqfs_write(struct vnop_write_args *ap)
+{
+	/* Accept and discard writes (console diagnostics). */
+	if ((int)(uintptr_t)vnode_fsnode(ap->a_vp) == D2XQFS_CONSOLE) {
+		return 0;
+	}
+	return EROFS;
+}
