diff --git a/bsd/vfs/vfs_subr.c b/bsd/vfs/vfs_subr.c
--- a/bsd/vfs/vfs_subr.c
+++ b/bsd/vfs/vfs_subr.c
@@ -13153,3 +13153,55 @@
 }
 
 #endif /* CONFIG_FILE_LEASES */
+
+
+/*
+ * d2xq: link stubs for the NativeUfs archive (ShengUfs).
+ *
+ * The driver references the VerifiedRoot kit (vr_open / vr_verify_block /
+ * vr_xnu_crypto and the key/policy bundle) and the RamBlock and boot-log
+ * shutdown helpers. The storage ABI bindings for this board do not exist yet,
+ * so provide failing stubs: the archive links, verification always fails and
+ * nothing is written back. Remove this patch once the real bindings arrive.
+ */
+const unsigned char verified_root_key[395] = { 0 };
+const unsigned long long verified_root_policies[1] = { 0 };
+const unsigned long long verified_root_policy_count = 0;
+const unsigned char vr_xnu_crypto[16] = { 0 };
+
+int
+vr_open(const void *envelope, unsigned long length, const void *key,
+    unsigned long long generation, const void *crypto, void *view)
+{
+	(void)envelope;
+	(void)length;
+	(void)key;
+	(void)generation;
+	(void)crypto;
+	(void)view;
+	return 1; /* fail closed: the root is never accepted as verified */
+}
+
+int
+vr_verify_block(const void *view, unsigned long long index, const void *data,
+    unsigned long length, const void *crypto)
+{
+	(void)view;
+	(void)index;
+	(void)data;
+	(void)length;
+	(void)crypto;
+	return 1;
+}
+
+int
+native_ram_block_shutdown(void)
+{
+	return 1;
+}
+
+int
+native_boot_log_shutdown(void)
+{
+	return 1;
+}
