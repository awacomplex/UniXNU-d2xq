diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -942,5 +942,15 @@
 	bsd_init_kprintf("calling bsd_autoconf\n");
-	bsd_autoconf();
+	{
+		kern_return_t status = bsd_autoconf();
+		unsigned ci194 = 0;
+		if (PE_parse_boot_argn("native-ufs-ci194", &ci194, sizeof(ci194)) &&
+		    ci194 == 1 && status != KERN_SUCCESS) {
+			panic("CI194 LATE FAIL bsd_autoconf %x", status);
+		}
+		/* Strong reference: a CI194 image cannot omit its terminal late hook. */
+		extern void native_source_storage_ci194_validate(void);
+		native_source_storage_ci194_validate();
+	}
 
 #if CONFIG_DTRACE
 	dtrace_postinit();
