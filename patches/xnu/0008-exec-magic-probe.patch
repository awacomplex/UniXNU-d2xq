diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
index d4c2ccc..d8623dc 100644
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -1222,6 +1222,12 @@ exec_mach_imgact(struct image_params *imgp)
 
 	if ((mach_header->magic != MH_MAGIC) &&
 	    (mach_header->magic != MH_MAGIC_64)) {
+		/* d2xq: show what the kernel actually read from the init file. */
+		panic("D2XQ n=%s magic=%x ft=%x sz=%llx mode=%x",
+		    imgp->ip_ndp ? imgp->ip_ndp->ni_cnd.cn_nameptr : "?",
+		    mach_header->magic, mach_header->filetype,
+		    (uint64_t)(imgp->ip_vattr ? imgp->ip_vattr->va_data_size : 0),
+		    (unsigned)(imgp->ip_vattr ? imgp->ip_vattr->va_mode : 0));
 		error = -1;
 		goto bad;
 	}
