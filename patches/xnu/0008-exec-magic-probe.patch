diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
index d4c2ccc..5b91579 100644
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -1222,6 +1222,15 @@ exec_mach_imgact(struct image_params *imgp)
 
 	if ((mach_header->magic != MH_MAGIC) &&
 	    (mach_header->magic != MH_MAGIC_64)) {
+		/* d2xq: show what the kernel read for the init file and the ramdisk
+		 * facts DarwinBoot appended to the boot command line. */
+		extern char *PE_boot_args(void);
+		panic("D2XQ n=%s magic=%x ft=%x sz=%llx mode=%x cmd=%s",
+		    imgp->ip_ndp ? imgp->ip_ndp->ni_cnd.cn_nameptr : "?",
+		    mach_header->magic, mach_header->filetype,
+		    (uint64_t)(imgp->ip_vattr ? imgp->ip_vattr->va_data_size : 0),
+		    (unsigned)(imgp->ip_vattr ? imgp->ip_vattr->va_mode : 0),
+		    PE_boot_args());
 		error = -1;
 		goto bad;
 	}
